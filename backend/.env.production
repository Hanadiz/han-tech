# Application
APP_NAME=Hanadiz API
APP_ENV=production
DEBUG=False
SECRET_KEY=${SECRET_KEY}
PORT=8000
HOST=0.0.0.0
WORKERS=4

# Database (Render will inject DATABASE_URL)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis (Render will inject REDIS_URL)
REDIS_SSL=True

# JWT
JWT_SECRET_KEY=${JWT_SECRET_KEY}
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=587
SMTP_USERNAME=${SMTP_USERNAME}
SMTP_PASSWORD=${SMTP_PASSWORD}
SMTP_USE_TLS=True
SMTP_FROM_EMAIL=noreply@hanadiz.com

# Payment Gateways
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}
STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK_SECRET}
PAYPAL_CLIENT_ID=${PAYPAL_CLIENT_ID}
PAYPAL_CLIENT_SECRET=${PAYPAL_CLIENT_SECRET}
PAYPAL_MODE=live

# Security
RATE_LIMIT_PER_MINUTE=100
MAX_UPLOAD_SIZE=10485760

# CORS
CORS_ORIGINS=https://hanadiz-client.onrender.com,https://hanadiz-admin.onrender.com

# Logging
LOG_LEVEL=WARNING
LOG_FILE=logs/app.log

# Monitoring
SENTRY_DSN=${SENTRY_DSN}
PROMETHEUS_ENABLED=True

# Backup
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/var/backups/hanadiz

# Celery
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
CELERY_TASK_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json