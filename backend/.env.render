APP_NAME=Hanadiz
APP_ENV=production
APP_DEBUG=false
APP_URL=https://hanadiz-backend.onrender.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=hanadiz-db.internal
DB_PORT=5432
DB_DATABASE=hanadiz
DB_USERNAME=hanadiz_user
DB_PASSWORD=${DB_PASSWORD}

BROADCAST_DRIVER=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=hanadiz-redis.internal
REDIS_PASSWORD=null
REDIS_PORT=6379