# ============================================
# HAN-TECH LTD - DOCKER ENVIRONMENT
# ============================================

APP_NAME="Han-Tech Ltd"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://han-tech-api.onrender.com

# Database (Render PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=${RENDER_DB_HOST:-hantech-db.frankfurt-postgres.render.com}
DB_PORT=5432
DB_DATABASE=${RENDER_DB_NAME:-hantech_db}
DB_USERNAME=${RENDER_DB_USER:-hantech_user}
DB_PASSWORD=${RENDER_DB_PASSWORD}

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Cache
CACHE_DRIVER=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Queue
QUEUE_CONNECTION=database

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=${SENDGRID_API_KEY}
MAIL_ENCRYPTION=tls

# Security
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
API_RATE_LIMIT=60
RUN_MIGRATIONS=false